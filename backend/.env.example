# Copy this file to .env and replace the placeholder values with your real Africa's Talking credentials.
AT_USERNAME=sandbox
AT_API_KEY=your_africastalking_api_key_here
AT_SENDER_ID=SignalProof
AT_ENVIRONMENT=sandbox

# Optional app settings
SECRET_KEY=change_this_to_a_long_random_secret
DEFAULT_AIRTIME_AMOUNT=50.0
DEFAULT_CURRENCY=KES
MOCK_AT_SERVICES=false
MOCK_NETWORK=true
SIMULATED_CELL_TOWER_ID=
USSD_CODE=*384*#
